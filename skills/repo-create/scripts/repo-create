#!/usr/bin/env bash
# Create a verified GitHub/Forgejo repository and clone it, or explicitly reuse it.
set -euo pipefail

error() { printf 'Error: %s\n' "$1" >&2; exit 1; }
info() { printf '%s\n' "$1"; }

show_help() {
    printf '%s\n' \
        'Usage: repo-create --name NAME --host github|forgejo --owner OWNER' \
        '                   --visibility private|public|internal --description DESC --path PATH' \
        '                   [--instance HOST[:PORT]] [--reuse-existing]' \
        '' \
        'Required: --name/-n, --host/-h, --owner, --visibility, --description/-d, --path/-p.' \
        'GitHub instance defaults to github.com; Forgejo requires --instance.' \
        'Instances must be HTTPS hosts (no scheme, credentials, or subpath).' \
        'Forgejo supports private/public; a non-login owner is treated as an organization.' \
        '--reuse-existing verifies the remote without creating it, then clones or verifies' \
        'an existing checkout. Empty directories are allowed only in this recovery mode.' \
        'No files are removed, no checkout is reset, and no project is registered/scaffolded.'
}

NAME="" HOST="" OWNER="" VISIBILITY="" DESCRIPTION="" LOCAL_PATH="" INSTANCE=""
REUSE=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        --name|-n|--host|-h|--owner|--visibility|--description|-d|--path|-p|--instance)
            [[ $# -ge 2 && -n "$2" && "$2" != --* ]] || error "Missing value for $1"
            case "$2" in -n|-h|-d|-p) error "Missing value for $1" ;; esac
            case "$1" in
                --name|-n) NAME="$2" ;;
                --host|-h) HOST="$2" ;;
                --owner) OWNER="$2" ;;
                --visibility) VISIBILITY="$2" ;;
                --description|-d) DESCRIPTION="$2" ;;
                --path|-p) LOCAL_PATH="$2" ;;
                --instance) INSTANCE="$2" ;;
            esac
            shift 2 ;;
        --reuse-existing) REUSE=true; shift ;;
        --help) show_help; exit 0 ;;
        *) error "Unknown option: $1" ;;
    esac
done

[[ -n "$NAME" ]] || error 'Missing required argument: --name'
[[ -n "$HOST" ]] || error 'Missing required argument: --host'
[[ -n "$OWNER" ]] || error 'Missing required argument: --owner'
[[ -n "$VISIBILITY" ]] || error 'Missing required argument: --visibility (resolve user intent before creation)'
[[ -n "$DESCRIPTION" ]] || error 'Missing required argument: --description'
[[ -n "$LOCAL_PATH" ]] || error 'Missing required argument: --path'
HOST=$(printf '%s' "$HOST" | tr '[:upper:]' '[:lower:]')
[[ "$HOST" == github || "$HOST" == forgejo ]] || error '--host must be github or forgejo'
[[ "$VISIBILITY" == private || "$VISIBILITY" == public || "$VISIBILITY" == internal ]] ||
    error '--visibility must be private, public, or internal'
[[ "$HOST" != forgejo || "$VISIBILITY" != internal ]] || error 'Forgejo does not support internal visibility'
# Reject ambiguous path/option characters in repository identity, not in descriptions.
[[ "$NAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ && "$NAME" != *.git ]] ||
    error '--name must start with an ASCII letter/digit, contain only letters/digits/._-, and not end in .git'
[[ "$OWNER" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]] ||
    error '--owner must start with an ASCII letter/digit and contain only letters/digits/_-'
if [[ -z "$INSTANCE" ]]; then
    [[ "$HOST" == github ]] || error 'Forgejo requires --instance HOST[:PORT]'
    INSTANCE=github.com
fi
INSTANCE=$(printf '%s' "$INSTANCE" | tr '[:upper:]' '[:lower:]')
[[ "$INSTANCE" =~ ^[a-z0-9][a-z0-9.-]*(:[0-9]+)?$ ]] ||
    error '--instance must be an HTTPS host[:port], without scheme, credentials, or subpath'

LOCAL_PATH="${LOCAL_PATH/#\~\//$HOME/}"
# Make paths absolute so a leading dash cannot be interpreted as an option.
[[ "$LOCAL_PATH" == /* ]] || LOCAL_PATH="$PWD/$LOCAL_PATH"
# Remove trailing slashes so symlinks cannot evade the -L check.
while [[ "$LOCAL_PATH" != / && "$LOCAL_PATH" == */ ]]; do LOCAL_PATH="${LOCAL_PATH%/}"; done
[[ ! -L "$LOCAL_PATH" ]] || error "Refusing symlink target: $LOCAL_PATH"
if [[ -e "$LOCAL_PATH" ]]; then
    $REUSE || error "Local path already exists: $LOCAL_PATH. Verify identity and use --reuse-existing only if intended, or choose another path."
    [[ -d "$LOCAL_PATH" ]] || error "Local path is not a directory: $LOCAL_PATH"
fi
command -v git >/dev/null || error 'git is not installed'

# Constant shell program: every dynamic input travels as a separate positional argument.
# Interactive zsh preserves the established keyring environment; neutral cwd avoids
# fj inferring a different repository/instance from the caller's working tree.
fj_run() { zsh -ic 'cd / && exec fj "$@"' repo-create --host "$INSTANCE" --style minimal "$@"; }
gh_run() { GH_HOST="$INSTANCE" gh "$@"; }

TARGET="$OWNER/$NAME"
EXPECTED_URL="https://$INSTANCE/$TARGET"
REPO_URL="" VERIFIED_URL="" SSH_URL="" REMOTE_CREATED=false
local_failure() {
    if $REMOTE_CREATED; then
        printf 'Remote creation succeeded for %s on %s. Local clone not completed.\n' "$TARGET" "$INSTANCE" >&2
    else
        printf 'Existing remote requested: %s on %s. Local setup not completed.\n' "$TARGET" "$INSTANCE" >&2
    fi
    printf 'Verified URL: %s\nRecover with the same inputs and --reuse-existing after checking remote/local identity.\n' "${VERIFIED_URL:-not yet verified}" >&2
    error "$1"
}

if [[ "$HOST" == github ]]; then
    command -v gh >/dev/null || error 'gh CLI not installed. Install from https://cli.github.com/'
    gh_run auth status --hostname "$INSTANCE" >/dev/null 2>&1 ||
        error "gh CLI not authenticated for $INSTANCE. Run: gh auth login --hostname $INSTANCE"
else
    command -v zsh >/dev/null || error 'zsh is required for Forgejo keyring access'
    command -v fj >/dev/null || error 'fj CLI not installed. Install with: cargo install forgejo-cli'
    if ! WHOAMI=$(fj_run whoami 2>&1); then
        error "fj CLI not authenticated for $INSTANCE. Run: fj --host $INSTANCE auth login $INSTANCE
$WHOAMI"
    fi
    # fj 0.5.x whoami uses this exact format, including the selected instance.
    [[ "$WHOAMI" == 'currently signed in to '*"@$INSTANCE" ]] ||
        error "Cannot verify Forgejo login/instance from whoami: $WHOAMI"
    LOGIN="${WHOAMI#currently signed in to }"
    LOGIN="${LOGIN%@*}"
    [[ "$LOGIN" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]] || error 'Cannot verify Forgejo login identity'
fi

if ! $REUSE; then
    info "Creating $TARGET on $INSTANCE ($VISIBILITY)..."
    if [[ "$HOST" == github ]]; then
        CREATE=(gh_run repo create "$TARGET" "--$VISIBILITY" --description "$DESCRIPTION")
    else
        if [[ "$OWNER" == "$LOGIN" ]]; then
            CREATE=(fj_run repo create "$NAME" --description "$DESCRIPTION")
        else
            CREATE=(fj_run org repo create "$OWNER" "$NAME" --description "$DESCRIPTION")
        fi
        [[ "$VISIBILITY" != private ]] || CREATE+=(--private)
    fi
    if ! OUTPUT=$("${CREATE[@]}" 2>&1); then
        error "Remote creation failed or its outcome is uncertain for $TARGET on $INSTANCE:
$OUTPUT
Verify the intended remote; use --reuse-existing only if it exists and reuse is intended, or choose another name."
    fi
    REMOTE_CREATED=true
fi

# Re-read the selected repository. Never trust an arbitrary URL in create output or
# synthesize a repository URL from the authenticated user's name.
if [[ "$HOST" == github ]]; then
    if ! OUTPUT=$(gh_run repo view "$EXPECTED_URL" --json nameWithOwner,url,sshUrl,visibility \
        --jq '[.nameWithOwner,.url,.sshUrl,.visibility] | @tsv' 2>&1); then
        local_failure "Cannot verify GitHub remote: $OUTPUT"
    fi
    IFS=$'\t' read -r ACTUAL_ID REPO_URL SSH_URL ACTUAL_VISIBILITY <<< "$OUTPUT"
    [[ "$ACTUAL_VISIBILITY" == "$(printf '%s' "$VISIBILITY" | tr '[:lower:]' '[:upper:]')" ]] ||
        local_failure "Remote visibility does not match --visibility $VISIBILITY; no settings changed."
else
    if ! OUTPUT=$(fj_run repo view "$TARGET" 2>&1); then
        local_failure "Cannot verify Forgejo remote: $OUTPUT"
    fi
    ACTUAL_ID="${OUTPUT%%$'\n'*}"
    # fj 0.5.x ends view output with its API-returned html_url. Descriptions have
    # a prefix; only the final exact marker is accepted (no broad URL scraping).
    LAST_LINE="${OUTPUT##*$'\n'}"
    [[ "$LAST_LINE" == 'View online at '* ]] || local_failure 'Forgejo view did not return a repository URL'
    REPO_URL="${LAST_LINE#View online at }"
fi
[[ "$ACTUAL_ID" == "$TARGET" && "$REPO_URL" == "$EXPECTED_URL" ]] ||
    local_failure "Remote identity/URL mismatch; expected $EXPECTED_URL, got $ACTUAL_ID at $REPO_URL"
VERIFIED_URL="$REPO_URL"
info "Verified remote: $REPO_URL"

verify_checkout() {
    local top origin physical
    top=$(git -C "$LOCAL_PATH" rev-parse --show-toplevel 2>/dev/null) ||
        local_failure "Existing nonempty path is not a checkout: $LOCAL_PATH. Leave it intact and choose a new path."
    physical=$(cd "$LOCAL_PATH" && pwd -P)
    [[ "$top" == "$physical" ]] || local_failure "Path is inside another checkout, not its root: $LOCAL_PATH"
    origin=$(git -C "$LOCAL_PATH" remote get-url --all origin 2>/dev/null) ||
        local_failure 'Checkout has no verifiable origin; no local files changed.'
    [[ "$origin" == "$REPO_URL" || "$origin" == "$REPO_URL.git" ||
       ( -n "$SSH_URL" && "$origin" == "$SSH_URL" ) ]] ||
        local_failure "Checkout origin does not match verified remote: $origin. No local files changed."
}

# Recheck after remote operations as the target may have appeared in the meantime.
[[ ! -L "$LOCAL_PATH" ]] || local_failure "Refusing symlink target: $LOCAL_PATH"
if [[ -e "$LOCAL_PATH" ]]; then
    $REUSE || local_failure "Local path appeared during creation: $LOCAL_PATH; refusing to overwrite it."
    [[ -d "$LOCAL_PATH" ]] || local_failure "Local path is not a directory: $LOCAL_PATH"
    shopt -s nullglob dotglob
    ENTRIES=("$LOCAL_PATH"/*)
    if [[ ${#ENTRIES[@]} -gt 0 ]]; then
        verify_checkout
        info "Reused verified checkout without changing files: $LOCAL_PATH"
        exit 0
    fi
else
    mkdir -p "$(dirname "$LOCAL_PATH")" || local_failure "Cannot create parent directory for $LOCAL_PATH"
    # Reserve the leaf atomically, rather than cloning into an unexamined existing path.
    mkdir "$LOCAL_PATH" || local_failure "Cannot reserve clone destination: $LOCAL_PATH"
fi

info "Cloning to $LOCAL_PATH..."
if ! git clone -- "$REPO_URL" "$LOCAL_PATH"; then
    local_failure 'Failed to clone. Remote remains available; local contents were not removed. If the path is nonempty and cannot be verified, choose a fresh path.'
fi
verify_checkout
info "Repository ready (no registration or scaffolding performed).
URL:  $REPO_URL
Path: $LOCAL_PATH"
